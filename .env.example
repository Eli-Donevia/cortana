# Donevia Jarvis settings (all optional)
# ------------------------------------------------------------------
# The easy way: run  npm run settings  in the donevia-jarvis folder. It makes
# "Jarvis settings.txt" from this file and opens it in TextEdit. Then delete
# the "#" in front of a setting and change its value. (Developers can use
# .env.local instead; "Jarvis settings.txt" wins if both exist.) Jarvis runs
# fine with neither, and neither is ever committed.
#
# The bridge reads these at start-up and hands the voice settings to the face
# through http://127.0.0.1:8787/config, so nothing here is built into the web
# page. After a change, quit and run `npm start` again.
#
# Never put Anthropic API keys here. Jarvis uses your Claude Code login
# (claude.ai), which is what gives it HQ and your connectors.

# --- Voice -----------------------------------------------------------

# kokoro = neural voice running inside Chrome (default). system = macOS voice.
# Kokoro downloads once (about 90-330 MB) and is cached. Until it is ready,
# and if it is too slow on this Mac, Jarvis uses the system voice and the
# footer says so (e.g. "Mac voice: Kokoro loading 42%").
# JARVIS_TTS_ENGINE=kokoro

# The Kokoro voice to start with. Easier: press V in Jarvis to hear the next
# one live; the pick is remembered until you change this line.
#   British:  bm_george, bm_fable, bm_lewis, bm_daniel,
#             bf_emma, bf_isabella
#   American: af_heart (best rated), af_bella, af_nicole,
#             am_michael, am_fenrir, am_puck
# JARVIS_KOKORO_VOICE=bf_emma  (default)

# auto (WebGPU, then WASM), webgpu or wasm.
# JARVIS_KOKORO_DEVICE=auto

# --- Wake word ---------------------------------------------------------

# How Jarvis hears his name:
#   auto       wake word with Chrome's on-device speech if available,
#              otherwise press Space to talk (default)
#   on-device  same as auto
#   cloud      always-on Chrome speech recognition. Audio goes to Google
#              while Jarvis is idle. Only if you accept that.
#   off        press Space (or click the reactor) to talk
# JARVIS_WAKE=auto

# Optional Picovoice Porcupine key for an offline "Jarvis" wake word.
# Also needs public/picovoice/porcupine_params.pv (see that folder's README).
# Leave blank to use the options above.
# PICOVOICE_ACCESS_KEY=

# What cuts her off while she is talking. Default words: her name, or a stop
# word ("stop", "wait", "hold on", "never mind"). name: only her name. any:
# any speech that is not her own voice (best with headphones).
# JARVIS_BARGE=words

# --- Brain -------------------------------------------------------------

# The HQ artifact Jarvis reads (and sends display commands to).
# DONEVIA_HQ_URL=

# Model and effort for spoken answers. Defaults: claude-haiku-5-5 (the fastest), low.
# JARVIS_MODEL=claude-haiku-5-5
# JARVIS_EFFORT=low

# Model and effort for the researcher, which takes the questions that need
# real research or thought. Defaults: opus (currently Opus 5.5), high.
# JARVIS_DEEP_MODEL=opus
# JARVIS_DEEP_EFFORT=high

# Speaking first: a nudge five minutes before meetings, and alerts only for
# completed Docusign envelopes and mail from pipeline contacts. 0 turns it off.
# JARVIS_PROACTIVE=1
# Quiet hours (Central): notices are shown, not spoken. Empty for none.
# JARVIS_QUIET_HOURS=22:30-07:00
# How often to look for alerts, in minutes. Default 20.
# JARVIS_ALERT_MINUTES=20

# Most tool round trips per question. Default 8.
# JARVIS_MAX_TURNS=8

# The one folder Cortana may list and rearrange (move, rename, new folder,
# "delete" into a Trash (Cortana) subfolder), each after a spoken yes.
# Default ~/Documents/Donevia, made if missing.
# JARVIS_FILES_DIR=

# --- Bridge ------------------------------------------------------------

# Port for the local bridge. Default 8787. The face follows it; restart
# Jarvis after changing it. (The face itself always uses port 5173.)
# JARVIS_BRIDGE_PORT=8787

# Keep ANTHROPIC_API_KEY and similar in the Claude Code environment.
# Default 0: they are removed, because they switch Claude Code off your
# claude.ai login and HQ and your connectors disappear.
# JARVIS_KEEP_API_KEY=0

# Extra page origins allowed to talk to the bridge, comma separated. They
# still need the launch token. Leave empty unless you know why.
# JARVIS_ALLOWED_ORIGINS=

# Print every tool decision to the terminal.
# JARVIS_DEBUG=0
